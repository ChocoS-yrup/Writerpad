{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:writerpad:sync-contract:protocol-schema:0.2.0",
  "title": "WriterPad Sync Contract Protocol",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "contract_version",
    "contract_status",
    "canonicalization",
    "supported_protocol_versions",
    "client_capabilities",
    "server_capabilities",
    "capability_version_rules",
    "immutable_batch_metadata",
    "operation_model",
    "project_sync_mode",
    "minimum_write_protocol",
    "structure_write_matrix",
    "atomic_structure_commit",
    "document_commit",
    "storage_name_normalization",
    "legacy_migration",
    "standard_error_codes",
    "server_invariants",
    "contract_allowlist",
    "evidence_policy"
  ],
  "properties": {
    "$schema": {
      "const": "./protocol.schema.json"
    },
    "contract_version": {
      "const": "0.2.0"
    },
    "contract_status": {
      "const": "released"
    },
    "canonicalization": {
      "$ref": "#/$defs/canonicalization"
    },
    "supported_protocol_versions": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/protocolVersion"
      }
    },
    "client_capabilities": {
      "$ref": "#/$defs/capabilityMap"
    },
    "server_capabilities": {
      "$ref": "#/$defs/capabilityMap"
    },
    "capability_version_rules": {
      "$ref": "#/$defs/nonEmptyStringMap"
    },
    "immutable_batch_metadata": {
      "$ref": "#/$defs/batchMetadataRule"
    },
    "operation_model": {
      "$ref": "#/$defs/operationModel"
    },
    "project_sync_mode": {
      "$ref": "#/$defs/projectSyncMode"
    },
    "minimum_write_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "LEGACY",
        "MIGRATING",
        "ID_BASED"
      ],
      "properties": {
        "LEGACY": {
          "$ref": "#/$defs/minimumWrite"
        },
        "MIGRATING": {
          "$ref": "#/$defs/minimumWrite"
        },
        "ID_BASED": {
          "$ref": "#/$defs/minimumWrite"
        }
      }
    },
    "structure_write_matrix": {
      "type": "array",
      "minItems": 7,
      "items": {
        "$ref": "#/$defs/structureWriteRule"
      }
    },
    "atomic_structure_commit": {
      "$ref": "#/$defs/atomicRule"
    },
    "document_commit": {
      "$ref": "#/$defs/documentRule"
    },
    "storage_name_normalization": {
      "$ref": "#/$defs/storageNameRule"
    },
    "legacy_migration": {
      "$ref": "#/$defs/legacyMigration"
    },
    "standard_error_codes": {
      "type": "array",
      "minItems": 25,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]+$"
      }
    },
    "server_invariants": {
      "type": "array",
      "minItems": 13,
      "items": {
        "$ref": "#/$defs/invariant"
      }
    },
    "contract_allowlist": {
      "$ref": "#/$defs/contractAllowlist"
    },
    "evidence_policy": {
      "$ref": "#/$defs/nonEmptyStringMap"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "nonEmptyStringMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "mode": {
      "enum": [
        "LEGACY",
        "MIGRATING",
        "ID_BASED"
      ]
    },
    "provenanceKind": {
      "enum": [
        "LEGACY_EPOCH_0",
        "CONTRACT_BATCH"
      ]
    },
    "canonicalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "standard",
        "media_type",
        "digest_algorithm",
        "digest_encoding",
        "digest_target",
        "self_reference_rule",
        "verification_rule"
      ],
      "properties": {
        "standard": {
          "const": "RFC 8785"
        },
        "media_type": {
          "const": "application/json"
        },
        "digest_algorithm": {
          "const": "SHA-256"
        },
        "digest_encoding": {
          "const": "lowercase-hex"
        },
        "digest_target": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "self_reference_rule": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "verification_rule": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "protocolVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "name",
        "write_project_modes",
        "required_client_capabilities",
        "required_server_capabilities",
        "batch_requirement",
        "provenance_kind",
        "description"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/positiveInteger"
        },
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "write_project_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/mode"
          }
        },
        "required_client_capabilities": {
          "$ref": "#/$defs/stringSet"
        },
        "required_server_capabilities": {
          "$ref": "#/$defs/stringSet"
        },
        "batch_requirement": {
          "enum": [
            "required",
            "forbidden"
          ]
        },
        "provenance_kind": {
          "$ref": "#/$defs/provenanceKind"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "capabilityMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "since_protocol",
          "meaning"
        ],
        "properties": {
          "since_protocol": {
            "$ref": "#/$defs/positiveInteger"
          },
          "scope": {
            "$ref": "#/$defs/identifier"
          },
          "meaning": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "batchMetadataField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "required"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "required": {
          "const": true
        }
      }
    },
    "batchMetadataRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applies_to_protocols",
        "immutable_after_create",
        "fields",
        "server_rules"
      ],
      "properties": {
        "applies_to_protocols": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/positiveInteger"
          }
        },
        "immutable_after_create": {
          "const": true
        },
        "fields": {
          "type": "array",
          "minItems": 8,
          "items": {
            "$ref": "#/$defs/batchMetadataField"
          }
        },
        "server_rules": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "immutableRecordRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "immutable_after_create",
        "required_fields",
        "entity_kinds",
        "intent_kinds"
      ],
      "properties": {
        "immutable_after_create": {
          "const": true
        },
        "required_fields": {
          "$ref": "#/$defs/stringSet"
        },
        "contract_batch_required_fields": {
          "$ref": "#/$defs/stringSet"
        },
        "optional_fields": {
          "$ref": "#/$defs/stringSet"
        },
        "entity_kinds": {
          "$ref": "#/$defs/stringSet"
        },
        "intent_kinds": {
          "$ref": "#/$defs/stringSet"
        }
      }
    },
    "rebaseRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "creates_new_intent",
        "required_new_fields",
        "rules"
      ],
      "properties": {
        "creates_new_intent": {
          "const": true
        },
        "required_new_fields": {
          "$ref": "#/$defs/stringSet"
        },
        "rules": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "attemptRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "append_only",
        "required_fields",
        "optional_fields",
        "outcomes"
      ],
      "properties": {
        "append_only": {
          "const": true
        },
        "required_fields": {
          "$ref": "#/$defs/stringSet"
        },
        "optional_fields": {
          "$ref": "#/$defs/stringSet"
        },
        "outcomes": {
          "$ref": "#/$defs/stringSet"
        }
      }
    },
    "eventRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "append_only",
        "required_fields",
        "event_types",
        "ordering_rule",
        "idempotency_rule"
      ],
      "properties": {
        "append_only": {
          "const": true
        },
        "required_fields": {
          "$ref": "#/$defs/stringSet"
        },
        "event_types": {
          "$ref": "#/$defs/stringSet"
        },
        "ordering_rule": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "idempotency_rule": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "stateDerivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_type",
        "result_state"
      ],
      "properties": {
        "event_type": {
          "$ref": "#/$defs/identifier"
        },
        "result_state": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "stateRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutable_projection",
        "states",
        "terminal_states",
        "derivation",
        "rules"
      ],
      "properties": {
        "mutable_projection": {
          "const": true
        },
        "states": {
          "$ref": "#/$defs/stringSet"
        },
        "terminal_states": {
          "$ref": "#/$defs/stringSet"
        },
        "derivation": {
          "type": "array",
          "minItems": 9,
          "items": {
            "$ref": "#/$defs/stateDerivation"
          }
        },
        "rules": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "cancellationRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idempotency_key",
        "rules"
      ],
      "properties": {
        "idempotency_key": {
          "$ref": "#/$defs/identifier"
        },
        "rules": {
          "type": "array",
          "minItems": 5,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "operationModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent",
        "rebase",
        "attempt",
        "event",
        "state",
        "cancellation"
      ],
      "properties": {
        "intent": {
          "$ref": "#/$defs/immutableRecordRule"
        },
        "rebase": {
          "$ref": "#/$defs/rebaseRule"
        },
        "attempt": {
          "$ref": "#/$defs/attemptRule"
        },
        "event": {
          "$ref": "#/$defs/eventRule"
        },
        "state": {
          "$ref": "#/$defs/stateRule"
        },
        "cancellation": {
          "$ref": "#/$defs/cancellationRule"
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/mode"
        },
        "to": {
          "$ref": "#/$defs/mode"
        }
      }
    },
    "migrationEpoch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "increment_on",
        "stale_epoch_behavior",
        "audit_fields"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "increment_on": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "stale_epoch_behavior": {
          "const": "reject"
        },
        "audit_fields": {
          "$ref": "#/$defs/stringSet"
        }
      }
    },
    "serverLock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "required_during",
        "owner_fields",
        "concurrent_writer_behavior"
      ],
      "properties": {
        "scope": {
          "const": "project_id"
        },
        "required_during": {
          "const": "MIGRATING"
        },
        "owner_fields": {
          "$ref": "#/$defs/stringSet"
        },
        "concurrent_writer_behavior": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "projectSyncMode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "states",
        "initial_state",
        "initial_epoch",
        "allowed_transitions",
        "automatic_promotion",
        "automatic_downgrade",
        "migration_epoch",
        "server_lock",
        "migration_validation"
      ],
      "properties": {
        "states": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/mode"
          }
        },
        "initial_state": {
          "const": "LEGACY"
        },
        "initial_epoch": {
          "const": 0
        },
        "allowed_transitions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/transition"
          }
        },
        "automatic_promotion": {
          "const": false
        },
        "automatic_downgrade": {
          "const": false
        },
        "migration_epoch": {
          "$ref": "#/$defs/migrationEpoch"
        },
        "server_lock": {
          "$ref": "#/$defs/serverLock"
        },
        "migration_validation": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "minimumWrite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content",
        "structure"
      ],
      "properties": {
        "content": {
          "$ref": "#/$defs/positiveInteger"
        },
        "structure": {
          "$ref": "#/$defs/positiveInteger"
        }
      }
    },
    "structureWriteRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_mode",
        "protocol_version",
        "allowed",
        "provenance_kind",
        "server_behavior"
      ],
      "properties": {
        "project_mode": {
          "enum": [
            "LEGACY",
            "MIGRATING",
            "ID_BASED",
            "MIGRATING_OR_ID_BASED"
          ]
        },
        "protocol_version": {
          "$ref": "#/$defs/positiveInteger"
        },
        "allowed": {
          "type": "boolean"
        },
        "provenance_kind": {
          "$ref": "#/$defs/provenanceKind"
        },
        "server_behavior": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "atomicRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_protocol",
        "wire_schema",
        "request_kind",
        "response_kinds",
        "idempotency_key",
        "atomic_boundary",
        "ordering_rule",
        "payload_digest_rule",
        "success_rule",
        "failure_rule",
        "replay_rule",
        "partial_apply_rule"
      ],
      "properties": {
        "required_protocol": {
          "const": 3
        },
        "wire_schema": {
          "const": "atomic-structure-commit.schema.json"
        },
        "request_kind": {
          "$ref": "#/$defs/identifier"
        },
        "response_kinds": {
          "$ref": "#/$defs/stringSet"
        },
        "idempotency_key": {
          "const": "batch_id"
        },
        "atomic_boundary": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "ordering_rule": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "payload_digest_rule": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "success_rule": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "failure_rule": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "replay_rule": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "partial_apply_rule": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "documentRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_protocol",
        "wire_schema",
        "request_kind",
        "response_kinds",
        "idempotency_key",
        "atomic_boundary",
        "ordering_rule",
        "payload_digest_rule",
        "success_rule",
        "failure_rule",
        "replay_rule",
        "partial_apply_rule",
        "intent_rules",
        "content_limit_bytes",
        "structure_barrier_rule"
      ],
      "properties": {
        "required_protocol": {
          "const": 3
        },
        "wire_schema": {
          "const": "document-commit.schema.json"
        },
        "request_kind": {
          "const": "document_commit_request"
        },
        "response_kinds": {
          "type": "array",
          "prefixItems": [
            { "const": "document_commit_success" },
            { "const": "document_commit_failure" }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "idempotency_key": {
          "const": "batch_id"
        },
        "atomic_boundary": { "$ref": "#/$defs/nonEmptyString" },
        "ordering_rule": { "$ref": "#/$defs/nonEmptyString" },
        "payload_digest_rule": { "$ref": "#/$defs/nonEmptyString" },
        "success_rule": { "$ref": "#/$defs/nonEmptyString" },
        "failure_rule": { "$ref": "#/$defs/nonEmptyString" },
        "replay_rule": { "$ref": "#/$defs/nonEmptyString" },
        "partial_apply_rule": { "$ref": "#/$defs/nonEmptyString" },
        "intent_rules": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "content_limit_bytes": {
          "const": 10485760
        },
        "structure_barrier_rule": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "storageNameRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm_id",
        "unicode_version",
        "input_scope",
        "steps",
        "separator_policy",
        "leading_space_policy",
        "internal_space_policy",
        "comparison_policy",
        "conformance_vectors"
      ],
      "properties": {
        "algorithm_id": {
          "const": "storage-name-v1"
        },
        "unicode_version": {
          "const": "15.0.0"
        },
        "input_scope": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "steps": {
          "type": "array",
          "minItems": 8,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "separator_policy": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "leading_space_policy": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "internal_space_policy": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "comparison_policy": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "conformance_vectors": {
          "const": "conformance_vectors/storage-name-v1.json"
        }
      }
    },
    "legacyDefault": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_sync_mode",
        "migration_epoch",
        "contract_enforcement_started_at"
      ],
      "properties": {
        "project_sync_mode": {
          "const": "LEGACY"
        },
        "migration_epoch": {
          "const": 0
        },
        "contract_enforcement_started_at": {
          "type": "null"
        }
      }
    },
    "legacyMigration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legacy_provenance_kind",
        "contract_provenance_kind",
        "default_for_existing_projects",
        "unknown_metadata_policy",
        "history_policy",
        "enforcement_boundary",
        "promotion_rule",
        "failure_rule",
        "legacy_invariant_scope"
      ],
      "properties": {
        "legacy_provenance_kind": {
          "const": "LEGACY_EPOCH_0"
        },
        "contract_provenance_kind": {
          "const": "CONTRACT_BATCH"
        },
        "default_for_existing_projects": {
          "$ref": "#/$defs/legacyDefault"
        },
        "unknown_metadata_policy": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "history_policy": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "enforcement_boundary": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "promotion_rule": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "failure_rule": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "legacy_invariant_scope": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rule"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^INV-[0-9]{3}$"
        },
        "rule": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "contractAllowlist": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "key",
        "allowlist_entry_fields",
        "validation_order",
        "unknown_digest_behavior",
        "digest_mismatch_behavior",
        "client_declarations_are_authoritative"
      ],
      "properties": {
