{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:writerpad:sync-contract:atomic-structure-commit:0.2.0",
  "title": "WriterPad atomic_structure_commit wire contract",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/success"
    },
    {
      "$ref": "#/$defs/failure"
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "capabilitySet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "batchMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_id",
        "writer_device_id",
        "client_build_id",
        "sync_protocol_version",
        "contract_version",
        "canonical_contract_sha256",
        "client_capabilities",
        "batch_payload_sha256"
      ],
      "properties": {
        "batch_id": {
          "$ref": "#/$defs/uuid"
        },
        "writer_device_id": {
          "$ref": "#/$defs/uuid"
        },
        "client_build_id": {
          "type": "string",
          "minLength": 1
        },
        "sync_protocol_version": {
          "const": 3
        },
        "contract_version": {
          "const": "0.2.0"
        },
        "canonical_contract_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "client_capabilities": {
          "$ref": "#/$defs/capabilitySet"
        },
        "batch_payload_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "operation_id",
        "batch_id",
        "entity_kind",
        "entity_id",
        "intent_kind",
        "base_revision",
        "payload_sha256",
        "payload"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "operation_id": {
          "$ref": "#/$defs/uuid"
        },
        "batch_id": {
          "$ref": "#/$defs/uuid"
        },
        "entity_kind": {
          "enum": [
            "project",
            "folder",
            "document",
            "tree_order",
            "trash_purge"
          ]
        },
        "entity_id": {
          "$ref": "#/$defs/uuid"
        },
        "intent_kind": {
          "enum": [
            "ensure",
            "create",
            "update",
            "rename",
            "move",
            "delete",
            "restore",
            "reorder",
            "migrate"
          ]
        },
        "base_revision": {
          "type": "integer",
          "minimum": 0
        },
        "payload_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "supersedes_operation_id": {
          "$ref": "#/$defs/uuid"
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "project_id",
        "project_sync_mode",
        "migration_epoch",
        "batch",
        "ordered_intents"
      ],
      "properties": {
        "kind": {
          "const": "atomic_structure_commit_request"
        },
        "project_id": {
          "$ref": "#/$defs/uuid"
        },
        "project_sync_mode": {
          "enum": [
            "LEGACY",
            "MIGRATING",
            "ID_BASED"
          ]
        },
        "migration_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "batch": {
          "$ref": "#/$defs/batchMetadata"
        },
        "ordered_intents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/intent"
          }
        }
      }
    },
    "intentResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "operation_id",
        "entity_id",
        "result_revision"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "operation_id": {
          "$ref": "#/$defs/uuid"
        },
        "entity_id": {
          "$ref": "#/$defs/uuid"
        },
        "result_revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "batch_id",
        "batch_payload_sha256",
        "status",
        "applied",
        "results"
      ],
      "properties": {
        "kind": {
          "const": "atomic_structure_commit_success"
        },
        "batch_id": {
          "$ref": "#/$defs/uuid"
        },
        "batch_payload_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "enum": [
            "committed",
            "replayed"
          ]
        },
        "applied": {
          "const": true
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/intentResult"
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "failed_sequence"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "failed_sequence": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "batch_id",
        "batch_payload_sha256",
        "status",
        "applied",
        "error",
        "results"
      ],
      "properties": {
        "kind": {
          "const": "atomic_structure_commit_failure"
        },
        "batch_id": {
          "$ref": "#/$defs/uuid"
        },
        "batch_payload_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "const": "rejected"
        },
        "applied": {
          "const": false
        },
        "error": {
          "$ref": "#/$defs/error"
        },
        "results": {
          "type": "array",
          "maxItems": 0
        }
      }
    }
  }
}
