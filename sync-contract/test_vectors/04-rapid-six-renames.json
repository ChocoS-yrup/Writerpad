{
  "$schema": "../transition-vector.schema.json",
  "vector_id": "TV-004",
  "title": "Six rapid structural renames",
  "contract_version": "0.2.0",
  "minimum_protocol_version": 3,
  "tags": [
    "fifo",
    "rapid-rename",
    "tree-order"
  ],
  "initial_server_state": {
    "project_id": "00000000-0000-4000-8000-000000000004",
    "project_sync_mode": "ID_BASED",
    "migration_epoch": 1,
    "entities": [
      {
        "entity_id": "30000000-0000-4000-8000-000000000011",
